Algoritmo Ejercico7
	
	Definir niños, niñas, total Como Real;
	Definir porcentaje_niños, porcentaje_niñas Como Real;
	
	Escribir "Introduce el número de niños:";
	Leer niños;
	
	Escribir "Introduce el número de niñas:";
	Leer niñas;
	
	total <- ninos + ninas;
	
	porcentajeNinos <- (ninos * 100) / total;
	porcentajeNinas <- (ninas * 100) / total;
	
	Escribir "El porcentaje de niños es: ", porcentajeNinos, "%";
	Escribir "El porcentaje de niñas es: ", porcentajeNinas, "%";
	
FinAlgoritmo
