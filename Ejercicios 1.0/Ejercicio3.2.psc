Algoritmo Ejercicio3AAD
	
	Definir num_a Como Entero;
	Definir num_b Como Entero;
	
	Escribir "Dime el valor de A";
	Leer num_a;
	Escribir "Dime el valor de B";
	Leer num_b;
	
	Si (num_a == num_b) Entonces
		Escribir "Los números son iguales " num_a == num_b;
	SiNo
		Escribir "El número A es mayor que el B " num_a > num_b;
		Escribir "El número B es mayor que el A " num_b > num_a;
	Fin Si
	
	
FinAlgoritmo
