Algoritmo Ejercicio6
	Definir num Como Real;
	
	Escribir "Introduce un número:";
	Leer num;
	
	Si num <= 0 Entonces
		Escribir "ERROR: El número debe ser mayor que 0";
	SiNo
		Escribir "El cuadrado de " num " es " num*num;
		Escribir "La raiz cuadrada de " num " es " RAIZ(num);
	FinSi
	
FinAlgoritmo
